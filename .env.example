# ─────────────────────────────────────────────────────────────
#  Ключи приложения Threads
# ─────────────────────────────────────────────────────────────
# Взять на developers.facebook.com → твоё приложение → раздел Threads API.
#
# ВНИМАНИЕ: Meta создаёт ДВА набора ключей. Нужны именно Threads App ID
# и Threads App Secret, а не generic App ID самого приложения.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Должен ТОЧНО совпадать с Redirect Callback URI в настройках приложения,
# включая слэш на конце. Для локальной работы сервер поднимать не нужно —
# код будет виден в адресной строке браузера.
THREADS_REDIRECT_URI=https://localhost:3000/callback


# ─────────────────────────────────────────────────────────────
#  Необязательные настройки
# ─────────────────────────────────────────────────────────────
# Meta в разное время документировала оба хоста. Если один отдаёт ошибку —
# раскомментируй и попробуй другой.
# THREADS_GRAPH_HOST=https://graph.threads.com
# THREADS_AUTH_HOST=https://threads.com
# THREADS_API_VERSION=v1.0

# Пауза между запросами к API, мс. Больше значение — меньше риск троттлинга.
# THREADS_THROTTLE_MS=250

# Куда складывать токен и очередь. По умолчанию — папка data/ в проекте.
# THREADS_DATA_DIR=/var/lib/threads-bot

# Подробный вывод запросов (секреты всё равно затираются).
# THREADS_BOT_DEBUG=1
